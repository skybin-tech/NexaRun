<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexaRun.Tray.Views.MessageDialog"
        Width="400" Height="180"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="HeadingText" FontWeight="Bold" FontSize="14" />
    <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="Gray" />
    <Button x:Name="OkBtn" Content="OK" HorizontalAlignment="Right" Margin="0 12 0 0" MinWidth="80" />
  </StackPanel>

</Window>
