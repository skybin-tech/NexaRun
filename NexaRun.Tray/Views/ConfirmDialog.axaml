<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexaRun.Tray.Views.ConfirmDialog"
        Width="360" Height="160"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="20" Spacing="10">
    <TextBlock x:Name="HeadingText" FontWeight="Bold" FontSize="14" />
    <TextBlock x:Name="BodyText" Foreground="Gray" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
      <Button x:Name="CancelBtn" Content="Cancel" />
      <Button x:Name="ConfirmBtn" Content="Confirm" />
    </StackPanel>
  </StackPanel>

</Window>
