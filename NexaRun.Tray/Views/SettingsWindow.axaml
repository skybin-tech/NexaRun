<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexaRun.Tray.Views.SettingsWindow"
        Title="NexaRun Settings"
        Width="540" Height="640"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="10">

      <TextBlock Text="Failed process recovery" FontWeight="Bold" FontSize="14" />
      <CheckBox x:Name="RecoveryEnabledBox"
                Content="Enable periodic recovery for Errored processes"
                IsChecked="True" />
      <TextBlock Text="Check interval (minutes, minimum 10)" />
      <TextBox x:Name="RecoveryIntervalBox" Watermark="10" />

      <Separator Margin="0 8" />

      <TextBlock Text="Email alerts (AWS SES)" FontWeight="Bold" FontSize="14" />
      <CheckBox x:Name="EmailEnabledBox"
                Content="Send email when a process goes from Online to Errored" />

      <TextBlock Text="Delivery method" />
      <ComboBox x:Name="EmailProviderBox" HorizontalAlignment="Stretch">
        <ComboBoxItem Content="SES API (IAM access key)" Tag="ses-api" />
        <ComboBoxItem Content="SES SMTP (SMTP credentials)" Tag="ses-smtp" />
      </ComboBox>

      <TextBlock Text="From (verified SES sender)" FontWeight="SemiBold" />
      <TextBox x:Name="EmailFromBox" Watermark="alerts@yourdomain.com" />

      <TextBlock Text="To (alert recipient)" />
      <TextBox x:Name="EmailToBox" Watermark="you@example.com" />

      <TextBlock Text="AWS region" Margin="0 4 0 0" />
      <TextBox x:Name="AwsRegionBox" Watermark="us-east-1" />

      <StackPanel x:Name="SesApiPanel" Spacing="8">
        <TextBlock Text="SES API credentials" FontWeight="SemiBold" Margin="0 4 0 0" />
        <TextBlock Text="IAM access key ID" />
        <TextBox x:Name="AwsAccessKeyBox" Watermark="AKIA..." />
        <TextBlock Text="IAM secret access key" />
        <TextBox x:Name="AwsSecretBox" PasswordChar="•" Watermark="Leave blank to keep existing" />
      </StackPanel>

      <StackPanel x:Name="SesSmtpPanel" Spacing="8" IsVisible="False">
        <TextBlock Text="SES SMTP credentials" FontWeight="SemiBold" Margin="0 4 0 0" />
        <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                   Text="Host is email-smtp.{region}.amazonaws.com (set automatically from region)." />
        <TextBlock Text="SMTP username (from SES → SMTP settings)" />
        <TextBox x:Name="SesSmtpUserBox" Watermark="SMTP username" />
        <TextBlock Text="SMTP password" />
        <TextBox x:Name="SesSmtpPasswordBox" PasswordChar="•" Watermark="Leave blank to keep existing" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <StackPanel Grid.Column="0">
            <TextBlock Text="SMTP port" />
            <TextBox x:Name="SesSmtpPortBox" Watermark="587" />
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
            <CheckBox x:Name="SesSmtpTlsBox" Content="Use TLS" IsChecked="True" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                 Text="Stored in %APPDATA%\NexaRun\settings.json on this machine." />

      <TextBlock x:Name="ErrorText" Foreground="Salmon" FontSize="12" IsVisible="False" TextWrapping="Wrap" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0 12 0 0">
        <Button x:Name="CancelBtn" Content="Cancel" />
        <Button x:Name="SaveBtn" Content="Save" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</Window>
