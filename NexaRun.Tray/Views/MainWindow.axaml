<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexaRun.Tray.Views.MainWindow"
        Title="NexaRun — Processes"
        Width="780" Height="440"
        MinWidth="600" MinHeight="300"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="12">

    <!-- Toolbar -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0 0 0 10">
      <Button x:Name="AddBtn" Content="＋ Add Process" />
      <Button x:Name="ImportBtn" Content="↓ Import JSON" />
      <Button x:Name="ExportBtn" Content="↑ Export JSON" />
      <Button x:Name="ClearAllBtn" Content="Clear All" Foreground="Salmon" IsEnabled="False" />
      <Button x:Name="SettingsBtn" Content="⚙ Settings" />
      <Button x:Name="RefreshBtn" Content="⟳ Refresh" />
      <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="Gray" FontSize="12" />
    </StackPanel>

    <!-- Action bar -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0 10 0 0">
      <Button x:Name="StopAllBtn" Content="Stop All" IsEnabled="False" />
      <Button x:Name="RestartAllBtn" Content="Restart All" IsEnabled="False" />
      <Button x:Name="OpenUrlBtn" Content="Open URL" IsEnabled="False" />
      <Button x:Name="StopBtn"    Content="Stop"    IsEnabled="False" />
      <Button x:Name="RestartBtn" Content="Restart" IsEnabled="False" />
      <Button x:Name="LogsBtn"    Content="Logs"    IsEnabled="False" />
      <Button x:Name="EditBtn"    Content="Edit"    IsEnabled="False" />
      <Button x:Name="DeleteBtn"  Content="Delete"  IsEnabled="False" Foreground="Salmon" />
    </StackPanel>

    <!-- Process grid -->
    <DataGrid x:Name="ProcessGrid"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              SelectionMode="Single"
              CanUserReorderColumns="False"
              CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Id"       Binding="{Binding Id}"       Width="40" />
        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"     Width="160" />
        <DataGridTextColumn Header="URL"      Binding="{Binding Url}"      Width="140" />
        <DataGridTextColumn Header="Status"   Binding="{Binding Status}"   Width="280" />
        <DataGridTextColumn Header="PID"      Binding="{Binding Pid}"      Width="70" />
        <DataGridTextColumn Header="Restarts" Binding="{Binding Restarts}" Width="70" />
        <DataGridTextColumn Header="Memory"   Binding="{Binding Memory}"   Width="80" />
        <DataGridTextColumn Header="Uptime"   Binding="{Binding Uptime}"   Width="70" />
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</Window>
