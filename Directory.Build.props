<Project>
  <PropertyGroup>
    <Version>1.0.10</Version>
    <AssemblyVersion>1.0.10.0</AssemblyVersion>
    <FileVersion>1.0.10.0</FileVersion>
    <InformationalVersion>1.0.10</InformationalVersion>
    <!-- Transitive Avalonia → Tmds.DBus.Protocol; audit off so restore/build is not blocked (NU1903) -->
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)skybin.snk</AssemblyOriginatorKeyFile>
    <DelaySign>false</DelaySign>
  </PropertyGroup>
</Project>
