<Project>
  <PropertyGroup>
    <Version>1.0.6</Version>
    <AssemblyVersion>1.0.6.0</AssemblyVersion>
    <FileVersion>1.0.6.0</FileVersion>
    <InformationalVersion>1.0.6</InformationalVersion>
    <!-- Transitive Avalonia → Tmds.DBus.Protocol; audit off so restore/build is not blocked (NU1903) -->
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
